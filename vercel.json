{
  "rewrites": [
    {
      "source": "/blog/:path*/",
      "destination": "/api/blog-proxy?path=:path*&trailingSlash=1"
    },
    {
      "source": "/blog/:path*",
      "destination": "/api/blog-proxy?path=:path*"
    },
    {
      "source": "/blog",
      "destination": "/api/blog-proxy?path="
    },
    {
      "source": "/blog/",
      "destination": "/api/blog-proxy?path="
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
